package com.hcl.guvi.capstonproject.eventmanagement.repository;
import java.time.LocalDateTime;
import java.util.List;



import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.hcl.guvi.capstonproject.eventmanagement.entity.EventEntity;



@Repository
public interface EventRepository extends JpaRepository<EventEntity,Long>{
	List<EventEntity> findByEventName(String eventName);
	List<EventEntity> findAllByOwnertName(String eventName);


@Query("SELECT COUNT(e) FROM EventEntity e WHERE e.ownerName= :ownerName AND FUNCTION('MONTH', e.eventDate) = :month AND FUNCTION('YEAR', e.eventDate) = :year")
int countEventsByOwnerAndMonth(@Param("ownerName") String ownerName,
                                @Param("month") LocalDateTime startOfMonth,
                                @Param("year") LocalDateTime startOfNextMonth);


}
