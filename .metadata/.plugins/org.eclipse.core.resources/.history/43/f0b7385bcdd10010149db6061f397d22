	@Override
	public String updateEvent(EventDto event) {
		EventEntity eventUpdateById=eventRepository.findById(event.getId()).orElseThrow(()->new 
				 ResourceNotFoundException("Event not found with ID: " + event.getId()));
;
					if(event.getEventDate()!=null) {
				eventUpdateById.setEventDate(event.getEventDate());
			}
			 if(event.getRsvp()!=null) {
				eventUpdateById.setRsvp(event.getRsvp());
			}
			 eventRepository.save(eventUpdateById);
			 logger.info("Event save Successfully",eventUpdateById.getId());
			 return "Successfully updated event";
		
	}


@Override
public List<EventDto> findAllEvent() {
    List<EventEntity> eventEntity = eventRepository.findAll();
    logger.info("Fetched {} events from database", eventEntity.size());

    List<EventDto> event = eventEntity.stream().map(entity -> {
        EventDto dto = new EventDto();
        dto.setId(entity.getId());
        dto.setEventName(entity.getEventName());
        dto.setEventDate(entity.getEventDate());
        dto.setRsvp(entity.getRsvp());

        // ✅ Map club ID safely (handle nulls to avoid NPE)
        ClubEntity club = entity.getClub();
        dto.setClubId(club != null ? club.getId() : null);

        return dto;
    }).collect(Collectors.toList());

    return event;
}


	@Override
	public EventDto findEventById(Long id) {

		  EventEntity eventEntity = eventRepository.findById(id)
		                .orElseThrow(() -> new ResourceNotFoundException("Event not found with ID: " + id));

		        logger.info("Fetched event by ID: {}", id);
		        return modelMapper.map(eventEntity, EventDto.class);

	}

	@Override
	public String deleteEventByName(String name) {


		 List<EventEntity> events = eventRepository.findByEventName(name);
		        if (events.isEmpty()) {
		            logger.error("Event not found with name: {}", name);
		            throw new ResourceNotFoundException("Event not found with name: " + name);
		        }

		        eventRepository.deleteAll(events);
		        logger.info("Deleted events with name: {}", name);
		        return "Successfully deleted event(s)";

		
		
	}

	@Override
	public String updateRsvp(Long id, Boolean rsvp) {

		 EventEntity eventEntity = eventRepository.findById(id)
		                .orElseThrow(() -> new ResourceNotFoundException("Event not found with ID: " + id));

		        eventEntity.setRsvp(rsvp);
		        eventRepository.save(eventEntity);
		        logger.info("RSVP updated for event ID: {}", id);
		        return "Successfully updated RSVP";

		
	}

