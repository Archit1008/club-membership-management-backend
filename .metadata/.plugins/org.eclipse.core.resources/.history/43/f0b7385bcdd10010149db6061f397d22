	@Override
    public String saveEvent(EventDto eventDto) {

YearMonth now = YearMonth.now();
LocalDateTime startOfMonth = now.atDay(1).atStartOfDay();
LocalDateTime startOfNextMonth = now.plusMonths(1).atDay(1).atStartOfDay();



        String ownerUserId = eventDto.getOwnerName();
        int currentMonthEvents = eventRepository.countEventsByOwnerAndMonth(
        	    ownerUserId, startOfMonth, startOfNextMonth
        	);
        Long clubId = eventDto.getClubId();

        // 1) Validate club exists and belongs to owner
        ClubEntity club = clubRepository.findById(clubId)
            .orElseThrow(() -> new IllegalArgumentException("Club not found"));
        if (!ownerUserId.equals(club.getOwnerName())) {
            throw new SecurityException("Owner does not own this club");
        }

        // 2) Fetch membership from User Management
        MembershipDTO membership = membershipClient.getActiveMembership(ownerUserId);
        if (membership == null || !"APPROVED".equalsIgnoreCase(membership.getStatus())) {
            throw new SecurityException("Active approved membership required to create events");
        }

        // 3) Convert membership type to MembershipPlan enum
        MembershipPlan plan;
        try {
            plan = MembershipPlan.valueOf(membership.getType().toUpperCase());
        } catch (IllegalArgumentException e) {
            throw new IllegalStateException("Invalid membership type: " + membership.getType());
        }

        // 4) Apply monthly limit using MembershipPolicy
        int maxAllowed = MembershipPolicy.maxEventsPerMonth(plan);
        YearMonth currentMonth = YearMonth.now();
      
        if (currentMonthEvents >= maxAllowed) {
            throw new IllegalStateException("Limit reached: " + maxAllowed +
                " events per month for " + plan.name());
        }

        // 5) Save event
        EventEntity event = new EventEntity();
        event.setEventName(eventDto.getEventName());
        event.setEventDate(eventDto.getEventDate());
        event.setRsvp(eventDto.getRsvp());
        event.setClub(club);
        event.setOwnerName(eventDto.getOwnerName());

        eventRepository.save(event);
        return "Event created successfully!";
    }


